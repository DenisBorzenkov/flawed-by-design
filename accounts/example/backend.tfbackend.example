# Per-account backend config. Generated by `accounts/_bootstrap/` -
# run that layer once, then paste the `backend_hcl` output here.
#
# Copy this file to `backend.tfbackend` (gitignored) and substitute the
# bucket name for your account. The `.tfbackend` suffix is the
# HashiCorp-recommended extension for partial backend configs from
# Terraform 1.6+; IDEs use it to skip top-level HCL validation.
#
# `key` is supplied per-layer at init time, NOT here, because each layer
# stores its own state under a layer-specific key.
#
# `use_lockfile = true` (TF 1.10+) puts the state lock as a `<key>.tflock`
# object next to each state object in this bucket. The legacy
# `dynamodb_table` argument is deprecated; we no longer maintain a
# lock table.

bucket       = "tfstate-123456789012-eu-central-1"
region       = "eu-central-1"
use_lockfile = true
encrypt      = true
