#   failure_threshold = 3
#   request_interval  = 30
#   measure_latency   = false
#   app_path          = "/healthz"
#   jenkins_path      = "/login"
# }

# route53_health_alarm = {
#   evaluation_periods = 2
#   period_seconds     = 60
# }

