# ============================================================================

# EstimatedCharges threshold (USD). Brief: $1/day.
# billing_threshold_usd        = 1
# billing_alarm_period_seconds = 21600   # 6h - billing metrics update infrequently

# alb_health_alarm = {
#   evaluation_periods = 2
#   period_seconds     = 60
#   threshold          = 1
# }

# alb_5xx_alarm = {
#   evaluation_periods = 1
#   period_seconds     = 300
#   threshold          = 0
# }

